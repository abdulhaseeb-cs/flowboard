# =====================================================================
# FlowBoard environment — copy to .env and change the secrets:
#   cp .env.example .env
# .env is git-ignored. Use letters and digits only for the passwords
# (they are embedded in a Redis URL).
# =====================================================================
APP_VERSION=1.0.0
WEB_PORT=80
NODE_ENV=production

# PostgreSQL
DB_NAME=flowboard
DB_USER=flowboard
DB_PASSWORD=ChangeMeDb2026

# Redis (pub/sub for WebSockets, rate limiting, worker locks)
REDIS_PASSWORD=ChangeMeRedis2026

# Auth — use a long random value: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW_SEC=900

# Uploads
MAX_UPLOAD_MB=10

# Worker: how often to check for due-date reminders (ms)
WORKER_INTERVAL_MS=30000

# Filled in automatically on EC2 by aws/user-data.sh (shown in the sidebar)
INSTANCE_ID=local
AVAILABILITY_ZONE=n/a
