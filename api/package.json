{
  "name": "flowboard-api",
  "version": "1.0.0",
  "description": "FlowBoard real-time project management API (Express + Socket.IO + PostgreSQL + Redis)",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "dev": "node --watch src/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "bcryptjs": "3.0.3",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "redis": "4.7.1",
    "socket.io": "4.8.4",
    "zod": "3.25.76"
  }
}
